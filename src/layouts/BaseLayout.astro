---
import '../styles/global.css';
import Topbar from '../components/site/Topbar.astro';
import Footer from '../components/site/Footer.astro';

interface Props {
  title: string;
}

const { title } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <slot name="head" />
  </head>
  <body>
    <Topbar />
    <slot />
    <Footer />
    <script>
      import '../scripts/site.js';
    </script>
  </body>
</html>
