---
import StoryCard from './StoryCard.astro';
import { storyItems } from '../../data/story';
---
<section class="story-section">
  <div class="story-header">
    <h1 class="story-title">Buna! Hej! Hi!<br />It's Paul Bader.</h1>
  </div>
  <div class="hl-stage" id="hlTrack">
    {storyItems.map(item => <StoryCard item={item} />)}
  </div>
  <div class="hl-controls" id="hlControls">
    <div class="hl-dot-shell">
      <div class="hl-dots" id="hlDots" aria-label="Hero story"></div>
    </div>
    <button class="hl-play" id="hlPlay" aria-label="Pause highlights gallery">
      <svg class="hl-ic-pause" viewBox="0 0 24 24"><rect x="7" y="6" width="3.4" height="12" rx="1.1"></rect><rect x="13.6" y="6" width="3.4" height="12" rx="1.1"></rect></svg>
      <svg class="hl-ic-play" viewBox="0 0 24 24"><path d="M8 5.5v13l11-6.5z"></path></svg>
    </button>
  </div>
</section>
