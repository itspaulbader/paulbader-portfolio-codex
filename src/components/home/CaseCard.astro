---
import type { ProjectCard } from '../../data/projects';
import { projectAnchorId } from '../../data/projects';
import { assetPath } from '../../utils/assetPath';

interface Props {
  project: ProjectCard;
}

const { project } = Astro.props;
const classes = ['card', project.themeClass, 'card-featured', project.extraClass].filter(Boolean).join(' ');
const mediaVars = [
  `--card-background:${project.backgroundColor}`,
  `--card-position-desktop:${project.desktopImage.position}`,
  `--card-position-mobile:${project.mobileImage.position}`,
  `--card-fit-desktop:${project.desktopImage.fit || 'cover'}`,
  `--card-fit-mobile:${project.mobileImage.fit || 'cover'}`
].join(';');
const desktopTextPlacement = project.textPlacement?.desktop || 'left';
const mobileTextPlacement = project.textPlacement?.mobile || 'center';
const unavailable = project.comingSoon || project.href === '#';
---
<article
  id={projectAnchorId(project.id)}
  class={classes}
  data-case={project.id}
  data-text-desktop={desktopTextPlacement}
  data-text-mobile={mobileTextPlacement}
  data-mobile-presentation={project.mobilePresentation || 'full-bleed'}
  style={mediaVars}
>
  <picture class="card-media">
    <source media="(max-width: 767px)" srcset={assetPath(project.mobileImage.src)} />
    <img src={assetPath(project.desktopImage.src)} alt={project.desktopImage.alt} />
  </picture>
  <div class="card-scrim"></div>
  <div class="card-body">
    <div>
      <div class="card-meta">
        {project.icon.type === 'image' ? (
          <div class="card-icon"><img src={assetPath(project.icon.src)} alt={project.icon.alt} /></div>
        ) : (
          <div class="card-icon" style={project.icon.style}>{project.icon.label}</div>
        )}
        <span class="card-co">{project.company}</span>
        <span class="card-dot"></span>
        <span class="card-yr">{project.year}</span>
      </div>
      <h3 class="card-title" set:html={project.titleHtml} />
      <p class="card-desc">{project.description}</p>
      <div class="card-tags">
        {project.tags.map(tag => <span class="card-tag">{tag}</span>)}
      </div>
    </div>
    <div class="card-cta">
      {unavailable ? (
        <span class="btn-soon">Coming Soon</span>
      ) : (
        <a href={project.href} class="btn-view">View Case</a>
      )}
    </div>
  </div>
</article>
