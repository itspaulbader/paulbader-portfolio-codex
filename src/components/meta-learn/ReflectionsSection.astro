---
import { reflections } from '../../data/metaLearn';
---
<section class="reflections" id="reflections">
  <div class="reflections-inner">
    <div class="refl-hd reveal">
      <div>
        <p class="label">{reflections.eyebrow}</p>
        <h2 class="heading-lg">{reflections.heading}</h2>
      </div>
    </div>

    <div class="refl-panel reveal d1">
      <div class="refl-takeaway">
        <p class="refl-takeaway-label">{reflections.takeawayLabel}</p>
        <p class="refl-takeaway-text">{reflections.takeawayText}</p>
        <p class="refl-takeaway-note">{reflections.takeawayNote}</p>
      </div>

      <div class="refl-lessons">
        {reflections.lessons.map(lesson => (
          <div class="refl-lesson">
            <span class="refl-lesson-num">{lesson.number}</span>
            <div>
              <p class="refl-lesson-label">{lesson.label}</p>
              <p class="refl-lesson-title">{lesson.title}</p>
              <p class="refl-lesson-body">{lesson.body}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
