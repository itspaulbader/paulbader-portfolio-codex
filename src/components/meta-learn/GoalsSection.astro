---
import { goals } from '../../data/metaLearn';
---
<section class="values" id="values">
  <div class="goals-head">
    <p class="label">{goals.eyebrow}</p>
    <h2 class="heading-lg">{goals.heading}</h2>
  </div>
  <div class="goals-sticky">
    <div class="goal-cloud" id="goalsMoment" aria-label={goals.ariaLabel}>
      {goals.bubbles.map(bubble => (
        <span
          class:list={['goal-bubble', bubble.kind === 'main' ? 'is-main' : 'is-small']}
          data-x0={bubble.x0}
          data-y0={bubble.y0}
          data-x1={bubble.x1}
          data-y1={bubble.y1}
          data-s0={bubble.s0}
          data-s1={bubble.s1}
          style={`--s:${bubble.size};`}
        >
          {bubble.text}
        </span>
      ))}
    </div>
    <div class="goal-vision" aria-live="polite">
      <p class="goal-vision-kicker">{goals.visionKicker}</p>
      <p class="goal-vision-text">{goals.visionText}</p>
    </div>
  </div>
</section>
