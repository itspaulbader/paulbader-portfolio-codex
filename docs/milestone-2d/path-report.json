    "routes": {
      "/": 200,
      "/index.html": 200,
      "/meta-learn.html": 200,
      "/meta-learn-next.html": 200,
      "/404.html": 200
    },
    "forbiddenDistMatches": []
  },
  "sourceSearch": {
    "command": "rg -n \"/portfolio/\" src",
    "matches": []
  }
}